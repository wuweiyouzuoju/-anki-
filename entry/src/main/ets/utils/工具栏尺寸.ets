// ========================================================
// @块ID UTIL-TOOLBAR-DIMENS-001
// @名称 浮动工具栏尺寸常量集
//
// @作用
// 集中托管浮动工具栏的尺寸常量与计算函数。
// 工具栏只有竖版一种形态（按钮纵向排列，像侧边栏贴左/右边），
// 拖动与吸附过程不切换布局，避免形态跳变。
// main question 阶段只有「显示答案」一个按钮，高度小；
// answer 阶段 4 个评分按钮纵向，高度大。
// 按钮内文字允许跨行（maxLines=2）。
//
// @输入
// 工具栏标识（main/aux）、学习阶段。
//
// @输出
// 尺寸常量；2 个类型别名；2 个计算函数（工具栏宽度 / 工具栏高度）。
//
// @业务规则
// 竖版宽度恒定（main/aux 均 96）；高度仅 main 按阶段区分（question 80 / answer 360）。
// 字符串值 'main' / 'aux' / 'left' / 'right' 保留英文
// （作为持久化与跨模块约定值）。
//
// @副作用
// 无。
//
// @注意
// 顶部预留 80 vp 含 TOOLBAR_HEIGHT + STATUS_BAR 估计值。
// 底部预留 44 vp：避开底部手势导航条（AppGallery 审核反馈）。
// ========================================================

/** 竖版尺寸。 */
export const 主工具栏_竖版_宽度: number = 96;
export const 主工具栏_竖版_高度_问题阶段: number = 80;
export const 主工具栏_竖版_高度_答案阶段: number = 360;
export const 辅助工具栏_竖版_宽度: number = 96;
export const 辅助工具栏_竖版_高度: number = 176;

/** 屏幕边缘留白（vp）：吸附后不贴边，方便手指抓取。侧边与底部统一此值。 */
export const 边缘留白: number = 12;

/** 顶部预留（vp）：避开顶栏（工具栏高度 + STATUS_BAR 估计值）。 */
export const 顶部预留: number = 80;

/** 底部预留（vp）：原 12 与侧边统一；AppGallery 审核反馈手势条遮挡浮动工具栏后
 *  调大为 44（原留白 12 + 手势条约 24~32），底部夹紧统一避开导航条。 */
export const 底部预留: number = 44;

/** 工具栏类型：main=主操作；aux=辅助操作（埋藏+暂停）。 */
export type 工具栏标识 = 'main' | 'aux';

/** 吸附侧别：竖版工具栏只贴左/右边。 */
export type 吸附侧 = 'left' | 'right';

// ========================================================
// @块ID UTIL-TOOLBAR-DIMENS-002
// @名称 计算工具栏当前宽度
//
// @作用
// 根据工具栏类型返回当前应使用的宽度（竖版宽度恒定）。
//
// @输入
// 工具栏类型（main / aux）
//
// @输出
// 当前宽度数值（vp）。
//
// @业务规则
// main 用 主工具栏_竖版_宽度；aux 用 辅助工具栏_竖版_宽度。
//
// @副作用
// 无。
// ========================================================

/** 计算工具栏当前宽度（竖版宽度恒定，不随阶段变化）。 */
export function 工具栏宽度(工具栏类型: 工具栏标识): number {
  return 工具栏类型 === 'main' ? 主工具栏_竖版_宽度 : 辅助工具栏_竖版_宽度;
}

// ========================================================
// @块ID UTIL-TOOLBAR-DIMENS-003
// @名称 计算工具栏当前高度
//
// @作用
// 根据工具栏类型、学习阶段返回当前应使用的高度。
//
// @输入
// 工具栏类型（main / aux）
// 学习阶段（仅 main 区分 question/answer）
//
// @输出
// 当前高度数值（vp）。
//
// @业务规则
// main：question 阶段用 主工具栏_竖版_高度_问题阶段；其他阶段用 _答案阶段。
// aux：用 辅助工具栏_竖版_高度。
//
// @副作用
// 无。
// ========================================================

/**
 * 计算工具栏当前高度。
 * @param 工具栏类型  工具栏类型
 * @param 学习阶段 学习阶段（仅 main 区分 question/answer）
 */
export function 工具栏高度(
  工具栏类型: 工具栏标识,
  学习阶段: 'loading' | 'question' | 'answer' | 'done' | 'error'
): number {
  if (工具栏类型 === 'main') {
    return 学习阶段 === 'question' ? 主工具栏_竖版_高度_问题阶段 : 主工具栏_竖版_高度_答案阶段;
  }
  return 辅助工具栏_竖版_高度;
}
