// ========================================================
// @块ID UTIL-TOOLBAR-DIMENS-001
// @名称 浮动工具栏尺寸常量集
//
// @作用
// 集中托管浮动工具栏的尺寸常量与计算函数：横版（拖动中）与
// 竖版（吸附态）两类尺寸，加上边缘留白、顶部/底部预留。
// 横版布局：main 4 评分按钮横向；aux 2 按钮横向。
// 竖版布局：按钮纵向排列，像侧边栏贴边。
// main question 阶段只有「显示答案」一个按钮，高度小；
// answer 阶段 4 个评分按钮纵向，高度大。
// 竖版高度加长，按钮内文字允许跨行（maxLines=2）。
//
// @输入
// 工具栏标识（main/aux）、是否吸附态、学习阶段。
//
// @输出
// 9 个尺寸常量；2 个类型别名；2 个计算函数（工具栏宽度 / 工具栏高度）。
//
// @业务规则
// 横版（H 后缀，拖动中）：main 4 评分按钮横向；aux 2 按钮横向。
// 竖版（V 后缀，吸附态）：按钮纵向排列。
// 竖版高度加长，按钮内文字允许跨行（maxLines=2）。
// 字符串值 'main' / 'aux' / 'left' / 'right' / 'top' / 'bottom' 保留英文
// （作为持久化与跨模块约定值）。
//
// @副作用
// 无。
//
// @注意
// 顶部预留 80 vp 含 TOOLBAR_HEIGHT + STATUS_BAR 估计值。
// 底部预留与侧边统一为 12，不再额外避开手势条
// （HarmonyOS 手势条高度约 24vp，若真机反馈遮挡再调大）。
// ========================================================

/** 横版尺寸（拖动中）。 */
export const 主工具栏_横版_宽度: number = 300;
export const 主工具栏_横版_高度: number = 116;
export const 辅助工具栏_横版_宽度: number = 176;
export const 辅助工具栏_横版_高度: number = 52;

/** 竖版尺寸（吸附态）。 */
export const 主工具栏_竖版_宽度: number = 96;
export const 主工具栏_竖版_高度_问题阶段: number = 80;
export const 主工具栏_竖版_高度_答案阶段: number = 360;
export const 辅助工具栏_竖版_宽度: number = 96;
export const 辅助工具栏_竖版_高度: number = 176;

/** 屏幕边缘留白（vp）：吸附后不贴边，方便手指抓取。侧边与底部统一此值。 */
export const 边缘留白: number = 12;

/** 顶部预留（vp）：避开顶栏（工具栏高度 + STATUS_BAR 估计值）。 */
export const 顶部预留: number = 80;

/** 底部预留（vp）：与侧边统一为 12，不再额外避开手势条
 *  （HarmonyOS 手势条高度约 24vp，若真机反馈手势条遮挡工具栏再调大）。 */
export const 底部预留: number = 12;

/** 工具栏类型：main=主操作；aux=辅助操作（埋藏+暂停）。 */
export type 工具栏标识 = 'main' | 'aux';

/** 吸附侧别：left/right 为竖版贴侧边；top/bottom 为横版贴顶/底。 */
export type 吸附侧 = 'left' | 'right' | 'top' | 'bottom';

// ========================================================
// @块ID UTIL-TOOLBAR-DIMENS-002
// @名称 计算工具栏当前宽度
//
// @作用
// 根据工具栏类型与吸附态返回当前应使用的宽度。
//
// @输入
// 工具栏类型（main / aux）
// 是否吸附态（true=竖版，false=横版）
//
// @输出
// 当前宽度数值（vp）。
//
// @业务规则
// 吸附态用竖版宽度；非吸附态用横版宽度。
// main 与 aux 各自的横/竖版宽度由上方常量定义。
//
// @副作用
// 无。
// ========================================================

/**
 * 计算工具栏当前宽度。
 * @param 工具栏类型      工具栏类型
 * @param 是否吸附态 是否吸附态（true=竖版，false=横版）
 */
export function 工具栏宽度(工具栏类型: 工具栏标识, 是否吸附态: boolean): number {
  if (是否吸附态) {
    return 工具栏类型 === 'main' ? 主工具栏_竖版_宽度 : 辅助工具栏_竖版_宽度;
  }
  return 工具栏类型 === 'main' ? 主工具栏_横版_宽度 : 辅助工具栏_横版_宽度;
}

// ========================================================
// @块ID UTIL-TOOLBAR-DIMENS-003
// @名称 计算工具栏当前高度
//
// @作用
// 根据工具栏类型、吸附态、学习阶段返回当前应使用的高度。
//
// @输入
// 工具栏类型（main / aux）
// 是否吸附态
// 学习阶段（仅 main 在竖版时区分 question/answer）
//
// @输出
// 当前高度数值（vp）。
//
// @业务规则
// 吸附态（竖版）：
//   main：question 阶段用 主工具栏_竖版_高度_问题阶段；其他阶段用 _答案阶段。
//   aux：用 辅助工具栏_竖版_高度。
// 非吸附态（横版）：main / aux 各自横版高度。
//
// @副作用
// 无。
// ========================================================

/**
 * 计算工具栏当前高度。
 * @param 工具栏类型      工具栏类型
 * @param 是否吸附态 是否吸附态
 * @param 学习阶段     学习阶段（仅 main 在竖版时区分 question/answer）
 */
export function 工具栏高度(
  工具栏类型: 工具栏标识,
  是否吸附态: boolean,
  学习阶段: 'loading' | 'question' | 'answer' | 'done' | 'error'
): number {
  if (是否吸附态) {
    if (工具栏类型 === 'main') {
      return 学习阶段 === 'question' ? 主工具栏_竖版_高度_问题阶段 : 主工具栏_竖版_高度_答案阶段;
    }
    return 辅助工具栏_竖版_高度;
  }
  return 工具栏类型 === 'main' ? 主工具栏_横版_高度 : 辅助工具栏_横版_高度;
}
