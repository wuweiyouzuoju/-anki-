// ========================================================
// @块ID UTIL-SNAP-CALC-001
// @名称 浮动工具栏吸附计算器
//
// @作用
// 提供浮动工具栏的位置夹紧与松手吸附计算：
//   - X / Y 方向夹紧（保证工具栏不超出屏幕边界）；
//   - 松手吸附（根据中心点判断更靠近哪一边，切换横/竖版布局）；
//   - 推断吸附侧（用于初始位置恢复时反推 snapSide）。
//
// @输入
// 工具栏当前位置、屏幕宽高、工具栏类型、是否吸附态、学习阶段。
//
// @输出
// 夹紧后的坐标；吸附结果（含坐标 + 吸附侧 + 是否吸附）；
// 推断吸附侧结果（仅含吸附侧 + 是否吸附）。
//
// @业务规则
// 学习阶段（loading/question/answer/done/error）字符串值保留英文
// （与浮动工具栏组件的 StudyPhase 同语义，独立声明避免循环依赖）。
// 吸附侧（left/right/top/bottom）字符串值保留英文。
// 左/右吸附 → 竖版贴侧边（snapped=true）；顶/底吸附 → 横版贴顶/底（snapped=false）。
// 中心点计算用竖版尺寸（松手后切换为竖版）。
//
// @副作用
// 无。仅做几何计算，不读不写状态。
//
// @注意
// 修改吸附判定阈值会影响松手体验；夹紧逻辑需保证工具栏不超出可见区域。
// ========================================================

import {
  边缘留白,
  底部预留,
  顶部预留,
  工具栏宽度,
  工具栏高度,
  工具栏标识,
  吸附侧
} from './工具栏尺寸';

/** 学习阶段（与浮动工具栏组件.学习阶段 同语义，独立声明避免循环依赖）。 */
export type 学习阶段 = 'loading' | 'question' | 'answer' | 'done' | 'error';

/** 吸附计算结果：松手后的位置 + 吸附侧 + 是否为吸附态。 */
export interface 吸附结果 {
  x: number;
  y: number;
  吸附侧: 吸附侧;
  是否吸附: boolean;
}

/** 推断吸附侧 返回类型：仅含吸附侧 + 是否吸附，不含坐标。 */
export interface 推断吸附侧结果 {
  吸附侧: 吸附侧;
  是否吸附: boolean;
}

// ========================================================
// @块ID UTIL-SNAP-CALC-002
// @名称 X 方向夹紧
//
// @作用
// 保证工具栏不超出左右边界（含 边缘留白）。
//
// @输入
// x            当前 X 坐标
// 屏幕宽        屏幕宽度
// 工具栏类型    工具栏类型
// 是否吸附态    是否吸附态
//
// @输出
// 夹紧后的 X 坐标。
//
// @业务规则
// 最小值 = 边缘留白；最大值 = 屏幕宽 - 工具栏宽度 - 边缘留白。
// 最大值若小于最小值则取最小值（避免窄屏负值）。
//
// @副作用
// 无。
// ========================================================

/** X 方向夹紧：保证工具栏不超出左右边界。 */
export function 夹紧X方向(x: number, 屏幕宽: number, 工具栏类型: 工具栏标识, 是否吸附态: boolean): number {
  const 最小: number = 边缘留白;
  const 最大: number = Math.max(最小, 屏幕宽 - 工具栏宽度(工具栏类型, 是否吸附态) - 边缘留白);
  if (x < 最小) {
    return 最小;
  }
  if (x > 最大) {
    return 最大;
  }
  return x;
}

// ========================================================
// @块ID UTIL-SNAP-CALC-003
// @名称 Y 方向夹紧
//
// @作用
// 保证工具栏不超出顶/底边界（含 顶部预留 / 底部预留）。
//
// @输入
// y            当前 Y 坐标
// 屏幕高        屏幕高度
// 工具栏类型    工具栏类型
// 是否吸附态    是否吸附态
// 学习阶段      学习阶段
//
// @输出
// 夹紧后的 Y 坐标。
//
// @业务规则
// 最小值 = 顶部预留；最大值 = 屏幕高 - 工具栏高度 - 底部预留。
// 最大值若小于最小值则取最小值。
//
// @副作用
// 无。
// ========================================================

/** Y 方向夹紧：保证工具栏不超出顶/底边界。 */
export function 夹紧Y方向(
  y: number,
  屏幕高: number,
  工具栏类型: 工具栏标识,
  是否吸附态: boolean,
  学习阶段: 学习阶段
): number {
  const 最小: number = 顶部预留;
  const 最大: number = Math.max(最小, 屏幕高 - 工具栏高度(工具栏类型, 是否吸附态, 学习阶段) - 底部预留);
  if (y < 最小) {
    return 最小;
  }
  if (y > 最大) {
    return 最大;
  }
  return y;
}

// ========================================================
// @块ID UTIL-SNAP-CALC-004
// @名称 松手吸附到侧边
//
// @作用
// 根据工具栏中心点判断更靠近哪一边（左/右/顶/底），
// 左/右 → 竖版贴侧边（snapped=true）；顶/底 → 横版贴顶/底（snapped=false）。
// 计算最终吸附位置并返回。
//
// @输入
// 当前X       松手时工具栏左上角 X
// 当前Y       松手时工具栏左上角 Y
// 屏幕宽      屏幕宽度
// 屏幕高      屏幕高度
// 工具栏类型  工具栏类型
// 学习阶段    学习阶段（仅 main 区分 question/answer）
//
// @输出
// 吸附结果（含 x / y / 吸附侧 / 是否吸附）。
//
// @业务规则
// 中心点用竖版尺寸（snapped=true）算，因为松手后切换为竖版。
// 四个距离取最小者决定吸附侧：
//   左 → snapped=true，X=边缘留白，Y 经 夹紧Y方向；
//   右 → snapped=true，X=屏幕宽-最终宽-边缘留白，Y 经 夹紧Y方向；
//   顶 → snapped=false，X 经 夹紧X方向，Y=顶部预留；
//   底 → snapped=false，X 经 夹紧X方向，Y=屏幕高-最终高-底部预留。
// 切换布局后用对应横/竖版尺寸算最终位置。
//
// @副作用
// 无。
//
// @注意
// 此函数不直接修改状态，调用方拿到结果后自行 setState。
// ========================================================

/**
 * 松手吸附：根据工具栏中心点判断更靠近哪一边（左/右/顶/底）；
 * 左/右 → 竖版贴侧边（snapped=true）；顶/底 → 横版贴顶/底（snapped=false）。
 * 中心点计算用竖版尺寸（松手后切换为竖版），所以传入 学习阶段 仅 main 区分 question/answer。
 */
export function 吸附到侧边(
  当前X: number,
  当前Y: number,
  屏幕宽: number,
  屏幕高: number,
  工具栏类型: 工具栏标识,
  学习阶段: 学习阶段
): 吸附结果 {
  // 用竖版尺寸（是否吸附态=true）算中心点，因为松手后切换为竖版
  const 当前宽: number = 工具栏宽度(工具栏类型, true);
  const 当前高: number = 工具栏高度(工具栏类型, true, 学习阶段);
  const 中心X: number = 当前X + 当前宽 / 2;
  const 中心Y: number = 当前Y + 当前高 / 2;
  const 距左: number = 中心X;
  const 距右: number = 屏幕宽 - 中心X;
  const 距顶: number = 中心Y - 顶部预留;
  const 距底: number = 屏幕高 - 底部预留 - 中心Y;
  const 最小距: number = Math.min(距左, 距右, 距顶, 距底);

  let 吸附侧结果: 吸附侧;
  let 是否吸附: boolean;
  if (最小距 === 距左) {
    吸附侧结果 = 'left';
    是否吸附 = true;
  } else if (最小距 === 距右) {
    吸附侧结果 = 'right';
    是否吸附 = true;
  } else if (最小距 === 距顶) {
    吸附侧结果 = 'top';
    是否吸附 = false;
  } else {
    吸附侧结果 = 'bottom';
    是否吸附 = false;
  }

  // 切换布局后的最终尺寸
  const 最终宽: number = 工具栏宽度(工具栏类型, 是否吸附);
  const 最终高: number = 工具栏高度(工具栏类型, 是否吸附, 学习阶段);
  let 吸附后X: number;
  let 吸附后Y: number;
  if (吸附侧结果 === 'left') {
    吸附后X = 边缘留白;
    吸附后Y = 夹紧Y方向(当前Y, 屏幕高, 工具栏类型, 是否吸附, 学习阶段);
  } else if (吸附侧结果 === 'right') {
    吸附后X = Math.max(边缘留白, 屏幕宽 - 最终宽 - 边缘留白);
    吸附后Y = 夹紧Y方向(当前Y, 屏幕高, 工具栏类型, 是否吸附, 学习阶段);
  } else if (吸附侧结果 === 'top') {
    吸附后X = 夹紧X方向(当前X, 屏幕宽, 工具栏类型, 是否吸附);
    吸附后Y = 顶部预留;
  } else {  // bottom
    吸附后X = 夹紧X方向(当前X, 屏幕宽, 工具栏类型, 是否吸附);
    吸附后Y = Math.max(顶部预留, 屏幕高 - 最终高 - 底部预留);
  }
  const 结果: 吸附结果 = { x: 吸附后X, y: 吸附后Y, 吸附侧: 吸附侧结果, 是否吸附 };
  return 结果;
}

// ========================================================
// @块ID UTIL-SNAP-CALC-005
// @名称 推断吸附侧
//
// @作用
// 推断保存位置的吸附侧（用于 加载初始位置 时恢复 吸附侧）。
// 与 吸附到侧边 同语义，但只返回 吸附侧 + 是否吸附，不计算最终位置。
//
// @输入
// 当前X       工具栏左上角 X
// 当前Y       工具栏左上角 Y
// 屏幕宽      屏幕宽度
// 屏幕高      屏幕高度
// 工具栏类型  工具栏类型
// 学习阶段    学习阶段
//
// @输出
// 推断吸附侧结果（吸附侧 + 是否吸附）。
//
// @业务规则
// 中心点用竖版尺寸算（与 吸附到侧边 一致）。
// 四个距离取最小者决定吸附侧：
//   左 → snapped=true；右 → snapped=true；顶 → snapped=false；底 → snapped=false。
//
// @副作用
// 无。
// ========================================================

/**
 * 推断保存位置的吸附侧（用于 加载初始位置 时恢复 吸附侧）。
 * 与 吸附到侧边 同语义，但只返回 吸附侧 + 是否吸附 不计算最终位置。
 */
export function 推断吸附侧(
  当前X: number,
  当前Y: number,
  屏幕宽: number,
  屏幕高: number,
  工具栏类型: 工具栏标识,
  学习阶段: 学习阶段
): 推断吸附侧结果 {
  const 宽: number = 工具栏宽度(工具栏类型, true);
  const 高: number = 工具栏高度(工具栏类型, true, 学习阶段);
  const 中心X: number = 当前X + 宽 / 2;
  const 中心Y: number = 当前Y + 高 / 2;
  const 距左: number = 中心X;
  const 距右: number = 屏幕宽 - 中心X;
  const 距顶: number = 中心Y - 顶部预留;
  const 距底: number = 屏幕高 - 底部预留 - 中心Y;
  const 最小距: number = Math.min(距左, 距右, 距顶, 距底);
  if (最小距 === 距左) {
    const 结果: 推断吸附侧结果 = { 吸附侧: 'left', 是否吸附: true };
    return 结果;
  }
  if (最小距 === 距右) {
    const 结果: 推断吸附侧结果 = { 吸附侧: 'right', 是否吸附: true };
    return 结果;
  }
  if (最小距 === 距顶) {
    const 结果: 推断吸附侧结果 = { 吸附侧: 'top', 是否吸附: false };
    return 结果;
  }
  const 结果: 推断吸附侧结果 = { 吸附侧: 'bottom', 是否吸附: false };
  return 结果;
}
