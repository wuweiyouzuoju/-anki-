// ========================================================
// @块ID UTIL-SNAP-CALC-001
// @名称 浮动工具栏吸附计算器
//
// @作用
// 提供浮动工具栏的位置夹紧与松手吸附计算：
//   - X / Y 方向夹紧（保证工具栏不超出屏幕边界）；
//   - 松手吸附（根据中心点判断更靠近左/右哪一边，竖版贴侧边）；
//   - 推断吸附侧（用于初始位置恢复时反推 吸附侧）。
//
// @输入
// 工具栏当前位置、屏幕宽高、工具栏类型、学习阶段。
//
// @输出
// 夹紧后的坐标；吸附结果（含坐标 + 吸附侧）；
// 推断吸附侧结果（仅含吸附侧）。
//
// @业务规则
// 学习阶段（loading/question/answer/done/error）字符串值保留英文
// （与浮动工具栏组件的 StudyPhase 同语义，独立声明避免循环依赖）。
// 吸附侧（left/right）字符串值保留英文。
// 工具栏只有竖版形态：贴左或贴右，Y 方向按当前阶段高度夹紧。
//
// @副作用
// 无。仅做几何计算，不读不写状态。
//
// @注意
// 修改吸附判定阈值会影响松手体验；夹紧逻辑需保证工具栏不超出可见区域。
// ========================================================

import {
  边缘留白,
  底部预留,
  顶部预留,
  工具栏宽度,
  工具栏高度,
  工具栏标识,
  吸附侧
} from './工具栏尺寸';

/** 学习阶段（与浮动工具栏组件.学习阶段 同语义，独立声明避免循环依赖）。 */
export type 学习阶段 = 'loading' | 'question' | 'answer' | 'done' | 'error';

/** 吸附计算结果：松手后的位置 + 吸附侧。 */
export interface 吸附结果 {
  x: number;
  y: number;
  吸附侧: 吸附侧;
}

/** 推断吸附侧 返回类型：仅含吸附侧，不含坐标。 */
export interface 推断吸附侧结果 {
  吸附侧: 吸附侧;
}

// ========================================================
// @块ID UTIL-SNAP-CALC-002
// @名称 X 方向夹紧
//
// @作用
// 保证工具栏不超出左右边界（含 边缘留白）。
//
// @输入
// x            当前 X 坐标
// 屏幕宽        屏幕宽度
// 工具栏类型    工具栏类型
//
// @输出
// 夹紧后的 X 坐标。
//
// @业务规则
// 最小值 = 边缘留白；最大值 = 屏幕宽 - 工具栏宽度 - 边缘留白。
// 最大值若小于最小值则取最小值（避免窄屏负值）。
//
// @副作用
// 无。
// ========================================================

/** X 方向夹紧：保证工具栏不超出左右边界。 */
export function 夹紧X方向(x: number, 屏幕宽: number, 工具栏类型: 工具栏标识): number {
  const 最小: number = 边缘留白;
  const 最大: number = Math.max(最小, 屏幕宽 - 工具栏宽度(工具栏类型) - 边缘留白);
  if (x < 最小) {
    return 最小;
  }
  if (x > 最大) {
    return 最大;
  }
  return x;
}

// ========================================================
// @块ID UTIL-SNAP-CALC-003
// @名称 Y 方向夹紧
//
// @作用
// 保证工具栏不超出顶/底边界（含 顶部预留 / 底部预留）。
//
// @输入
// y            当前 Y 坐标
// 屏幕高        屏幕高度
// 工具栏类型    工具栏类型
// 学习阶段      学习阶段（main 高度按阶段区分）
//
// @输出
// 夹紧后的 Y 坐标。
//
// @业务规则
// 最小值 = 顶部预留；最大值 = 屏幕高 - 工具栏高度 - 底部预留。
// 最大值若小于最小值则取最小值。
//
// @副作用
// 无。
// ========================================================

/** Y 方向夹紧：保证工具栏不超出顶/底边界。 */
export function 夹紧Y方向(
  y: number,
  屏幕高: number,
  工具栏类型: 工具栏标识,
  学习阶段: 学习阶段
): number {
  const 最小: number = 顶部预留;
  const 最大: number = Math.max(最小, 屏幕高 - 工具栏高度(工具栏类型, 学习阶段) - 底部预留);
  if (y < 最小) {
    return 最小;
  }
  if (y > 最大) {
    return 最大;
  }
  return y;
}

// ========================================================
// @块ID UTIL-SNAP-CALC-004
// @名称 松手吸附到侧边
//
// @作用
// 根据工具栏中心点 X 判断更靠近左/右哪一边，竖版贴到该侧。
// 计算最终吸附位置并返回。
//
// @输入
// 当前X       松手时工具栏左上角 X
// 当前Y       松手时工具栏左上角 Y
// 屏幕宽      屏幕宽度
// 屏幕高      屏幕高度
// 工具栏类型  工具栏类型
// 学习阶段    学习阶段（仅 main 区分 question/answer）
//
// @输出
// 吸附结果（含 x / y / 吸附侧）。
//
// @业务规则
// 中心点在屏幕左半 → 贴左（X=边缘留白）；右半 → 贴右（X=屏幕宽-宽-边缘留白）。
// Y 方向按当前阶段高度夹紧，不吸附到顶/底。
//
// @副作用
// 无。
//
// @注意
// 此函数不直接修改状态，调用方拿到结果后自行 setState。
// ========================================================

/**
 * 松手吸附：根据工具栏中心点 X 判断更靠近左/右哪一边，竖版贴到该侧；
 * Y 方向按当前阶段高度夹紧。
 */
export function 吸附到侧边(
  当前X: number,
  当前Y: number,
  屏幕宽: number,
  屏幕高: number,
  工具栏类型: 工具栏标识,
  学习阶段: 学习阶段
): 吸附结果 {
  const 宽: number = 工具栏宽度(工具栏类型);
  const 中心X: number = 当前X + 宽 / 2;
  const 贴左: boolean = 中心X < 屏幕宽 / 2;
  const 吸附侧结果: 吸附侧 = 贴左 ? 'left' : 'right';
  const 吸附后X: number = 贴左
    ? 边缘留白
    : Math.max(边缘留白, 屏幕宽 - 宽 - 边缘留白);
  const 吸附后Y: number = 夹紧Y方向(当前Y, 屏幕高, 工具栏类型, 学习阶段);
  const 结果: 吸附结果 = { x: 吸附后X, y: 吸附后Y, 吸附侧: 吸附侧结果 };
  return 结果;
}

// ========================================================
// @块ID UTIL-SNAP-CALC-005
// @名称 推断吸附侧
//
// @作用
// 推断保存位置的吸附侧（用于 加载初始位置 时恢复 吸附侧）。
// 与 吸附到侧边 同语义，但只返回 吸附侧，不计算最终位置。
//
// @输入
// 当前X       工具栏左上角 X
// 当前Y       工具栏左上角 Y
// 屏幕宽      屏幕宽度
// 屏幕高      屏幕高度
// 工具栏类型  工具栏类型
// 学习阶段    学习阶段
//
// @输出
// 推断吸附侧结果（吸附侧）。
//
// @业务规则
// 中心点 X 在屏幕左半 → left；右半 → right。
//
// @副作用
// 无。
// ========================================================

/**
 * 推断保存位置的吸附侧（用于 加载初始位置 时恢复 吸附侧）。
 * 与 吸附到侧边 同语义，但只返回 吸附侧 不计算最终位置。
 */
export function 推断吸附侧(
  当前X: number,
  当前Y: number,
  屏幕宽: number,
  屏幕高: number,
  工具栏类型: 工具栏标识,
  学习阶段: 学习阶段
): 推断吸附侧结果 {
  const 宽: number = 工具栏宽度(工具栏类型);
  const 中心X: number = 当前X + 宽 / 2;
  const 贴左: boolean = 中心X < 屏幕宽 / 2;
  const 结果: 推断吸附侧结果 = { 吸附侧: 贴左 ? 'left' : 'right' };
  return 结果;
}
